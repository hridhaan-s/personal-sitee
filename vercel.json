{
  "functions": {
    "api/memo.js": { "includeFiles": "{blog.html,memo-seed.json}", "maxDuration": 30 }
  },
  "redirects": [
    { "source": "/archive", "destination": "/achievements", "permanent": true },
    { "source": "/archive.html", "destination": "/achievements", "permanent": true },
    { "source": "/memo", "destination": "/blog", "permanent": false },
    { "source": "/admin/", "destination": "/admin", "permanent": true }
  ],
  "rewrites": [
    { "source": "/blog/rss.xml", "destination": "/api/memo?rss=1" },
    { "source": "/blog/feed", "destination": "/api/memo?rss=1" },
    { "source": "/blog/:slug", "destination": "/api/memo?page=:slug" },
    { "source": "/blog", "destination": "/api/memo?page=_index" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    { "source": "/admin.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "X-Frame-Options", "value": "DENY" }] }
  ]
}
